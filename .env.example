# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SP3 country × fulfilment checkout cutover. Deploy false; production flips are HITL.
CHECKOUT_COUNTRY_PARTITION_ENABLED=false


# Monday.com

MONDAY_WEBHOOK_SECRET=
# Production board — customer ORDERS and REORDERS land here in the "Pre-production"
# group. Code defaults to 1992701981 (PRODUCTION_BOARD_ID); set this to override
# (e.g. a staging board in preview). MUST be set in Vercel for Production + Preview.
MONDAY_PRODUCTION_BOARD_ID=
# Optional: route demo/test-org ORDERS (organizations.is_test) to a dedicated
# group on the Production board. Unset => demo orders fall back to Pre-production.
# (Reorders have no demo split — they always land in Pre-production.)
MONDAY_PRODUCTION_DEMO_GROUP_ID=
# Base URL for the Monday workspace — used to build deep links into items in AM emails.
MONDAY_BOARD_URL_PREFIX=https://theprint-room-group.monday.com

# Preview-as-member: shared HMAC secret. MUST be identical in both portals (staff + customer).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PREVIEW_TOKEN_SECRET=

# Demo
# Shared demo user's email — used by the one-click /api/demo/enter route.
DEMO_EMAIL=demo@theprint-room.co.nz
# Shared demo user's password. MUST match Supabase Auth's password policy
# (upper + lower + digit + symbol). Placeholder below — do not use in production.
DEMO_PASSWORD=ChangeMe-Str0ng!
# Where is_test order-confirmation emails are routed. Defaults to
# jamie@theprint-room.co.nz if unset.
DEMO_TEST_EMAIL=jamie@theprint-room.co.nz


# Order-placed notifications (internal, staff-facing)
# Recipient of the internal order-placed dispatch email for REAL orders.
# Defaults to charlotte@theprint-room.co.nz if unset.
DISPATCH_NOTIFICATION_EMAIL=charlotte@theprint-room.co.nz
# Base URL of the STAFF portal — used to deep-link staff notifications (dispatch
# email + Slack) at the order detail page. Defaults to https://staff.theprintroom.nz
# if unset. Set to a staging staff-portal URL in preview.
STAFF_PORTAL_URL=https://staff.theprintroom.nz

# --- Starshipit (push-only; dark until STARSHIPIT_ENABLED is truthy) ---
# Registers portal orders in the "Print Room Dispatch" account so staff can
# print courier tickets. Keys: Starshipit web app -> Settings -> API.
# STARSHIPIT_WEBHOOK_SECRET stays UNSET — inbound tracking is out of scope.
# STARSHIPIT_ENABLED=
# STARSHIPIT_API_KEY=
# STARSHIPIT_SUBSCRIPTION_KEY=

# Google Places (New) key for split-shipment ad-hoc address lookup.
# SERVER-ONLY: read in app/api/address-autocomplete/route.ts and never exposed
# to the browser (no NEXT_PUBLIC_ prefix). Unset is safe: the route returns 503
# and the checkout falls back to manual address entry.
GOOGLE_PLACES_API_KEY=
